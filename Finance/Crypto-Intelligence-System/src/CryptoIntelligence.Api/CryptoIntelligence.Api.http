@HostAddress = http://localhost:5264

GET {{HostAddress}}/health/live
X-Correlation-ID: local-health-check

###

GET {{HostAddress}}/health/ready
X-Correlation-ID: local-readiness-check

###

GET {{HostAddress}}/api/v1/system/status
Accept: application/json
X-Correlation-ID: local-status-check

###

GET {{HostAddress}}/api/v1/radar/candidates?status=Eligible&limit=50
Accept: application/json

###

GET {{HostAddress}}/api/v1/radar/candidates/{{tokenAddress}}
Accept: application/json

###

GET {{HostAddress}}/api/v1/ingestion/checkpoints
Accept: application/json

###

GET {{HostAddress}}/api/v1/ingestion/gaps?limit=100
Accept: application/json

###

GET {{HostAddress}}/api/v1/ingestion/capacity
Accept: application/json

###

